{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译固件 (arduino-cli)",
      "detail": "产出 build/TrafficLight.ino.hex，供 Wokwi 仿真读取",
      "type": "shell",
      "command": "C:/Users/谭/tools/arduino-cli/arduino-cli.exe",
      "args": [
        "compile",
        "--fqbn",
        "arduino:avr:uno",
        "--output-dir",
        "build",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
